#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == postgresql://* || "${1:-}" == postgres://* ]]; then
  shift
fi

args=()

while (($#)); do
  if [[ "$1" == "-f" && $# -ge 2 ]]; then
    args+=("-f" "/tmp/migrations/$(basename "$2")")
    shift 2
  else
    args+=("$1")
    shift
  fi
done

MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' \
  docker exec -i SALFRA-db psql -U postgres -d postgres "${args[@]}"
